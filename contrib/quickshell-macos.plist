<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts `qs -c CONFIG` at login and restarts it if it crashes.
  Install: sed "s|@HOME@|$HOME|g; s|@CONFIG@|mac|g" contrib/quickshell-macos.plist \
             > ~/Library/LaunchAgents/quickshell-macos.plist
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/quickshell-macos.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>quickshell-macos</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/qs</string>
        <string>-c</string>
        <string>@CONFIG@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>/tmp/quickshell-macos.log</string>
</dict>
</plist>
