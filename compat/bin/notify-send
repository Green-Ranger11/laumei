#!/bin/sh
# notify-send -> a macOS notification via osascript. Options are skipped
# (-a sets the subtitle); the first two plain arguments are summary and body.
app=""
while [ $# -gt 0 ]; do
    case "$1" in
        -a|--app-name) app="$2"; shift 2 ;;
        --app-name=*) app="${1#*=}"; shift ;;
        -u|--urgency|-t|--expire-time|-i|--icon|-c|--category|-h|--hint) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
summary="$1"
body="$2"
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
osascript -e "display notification \"$(esc "$body")\" with title \"$(esc "$summary")\" subtitle \"$(esc "$app")\""
